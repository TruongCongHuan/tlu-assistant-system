# Copy to repo root as `.env` (do not commit real keys)
GEMINI_API_KEY=

# Cursor SDK — dùng cho eval judge + generation (cursor.com/dashboard/integrations)
CURSOR_API_KEY=
# CURSOR_JUDGE=1      # 1 = dùng Cursor làm judge thay Gemini (mặc định khi có CURSOR_API_KEY)
# CURSOR_GENERATE=0   # 1 = dùng Cursor cho generation thay rag.stream_answer()
ADMIN_API_KEY=dev-admin-key
STUDENT_API_KEY=dev-student-key
STAFF_API_KEY=dev-staff-key
STAFF_JWT_SECRET=dev-staff-jwt-change

# Demo tối nay: lưu JSON trên ổ đĩa (không cần Firebase)
STORAGE_BACKEND=file
DATA_DIR=./data

# Staff-console (Docker): chọn MỘT trong hai cách —
#
# Cách B (file + mount, đã cấu hình trong docker-compose.yml):
#   1. Tạo thư mục secrets/ ở gốc repo
#   2. Đổi tên file key tải từ Firebase thành: secrets/firebase-sa.json
#   3. Để FIREBASE_SERVICE_ACCOUNT_JSON trống; không cần sửa GOOGLE_APPLICATION_CREDENTIALS
#      (mặc định trong container: /run/secrets/firebase-sa.json)
#
# Cách A (một dòng trong .env):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
# RAG CORS: thêm origin dev staff-console nếu cần
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000
# Optional retrieve-then-rerank (defaults preserve the existing context budget).
# Install services/rag-api/requirements-rerank.txt to enable the Cross-Encoder.
CANDIDATE_K=0
FINAL_K=5
RERANK_MODE=none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=1
RERANK_MAX_LENGTH=512
RERANK_INT8=0
RERANK_FAIL_OPEN=0
